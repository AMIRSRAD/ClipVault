{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipVault",
  "version": "1.1.0",
  "identifier": "com.clipvault.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipVault",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true
      },
      {
        "label": "palette",
        "title": "ClipVault Quick Paste",
        "width": 370,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "backgroundColor": "#1f1f1f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "compression": "lzma"
      }
    },
    "publisher": "Amirsalar Saberi rad",
    "copyright": "Copyright © Amirsalar Saberi rad. All rights reserved.",
    "homepage": "https://amirsrad.ir",
    "category": "Utility",
    "shortDescription": "Private, encrypted clipboard history for Windows",
    "longDescription": "ClipVault keeps an encrypted, searchable history of the text and images you copy, with notes, OCR, and a quick paste popup (Ctrl+Shift+V).",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREMDJEQjg3RTAxMjkwOTcKUldTWGtCTGdoOXNDM1FPQ0o3U3poNWhFQnVFcmE0MC83QVVCQ3pBdU9jT2tKbVpJMVhKc2tQK1oK",
      "endpoints": [
        "https://github.com/AMIRSRAD/ClipVault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
